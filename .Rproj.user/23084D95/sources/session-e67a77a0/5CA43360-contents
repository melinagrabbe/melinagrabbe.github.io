# Exercises
bikedata %>% 
  filter(temperature > 15) %>% 
  select(cyclists, temperature, weekday)

bikedata <- bikedata %>% mutate(season = case_when(
  temperature < 10 ~ "Cold", 
  temperature %in%  10:20 ~ "Mild", 
  TRUE ~ "Warm"
))
table(bikedata$season)

bikedata %>% 
  group_by(season) %>%
  summarise(
    avrg_cyclist = mean(cyclists),
    max_cyclist = max(cyclists)) %>% 
  arrange(desc(avrg_cyclist))

bikedata %>% 
  mutate (is_weekend = weekday %in%  c("Sat", "Sun")) %>% 
  group_by(is_weekend) %>% 
  summarise (avrg_cyclist = mean(cyclists), n=n(), .groups = "drop")

bikedata <- read_csv("bikedata.csv") %>%
  mutate(timestamp = ymd_hms(timestamp, truncated = 3))
    
bikedata %>% 
  mutate (hour = hour(timestamp)) %>% 
  group_by(hour) %>% 
  summarise(avrg_cyclist = mean(cyclists)) %>% 
  slice_max(avrg_cyclist)

bikedata %>% 
  filter(!(weekday %in% c("Sat", "Sun")),
         holiday == F) %>% 
  ggplot(aes(x = temperature, y = cyclists)) +
  geom_jitter(aes(col = weekday, alpha = 0.4, size = 0.2)) +
  xlab("Tempeeeeeeeeeeeeeeeerature")+
  ylab("Cyclists(z.B. Annika)") + 
  theme_minimal()

bikedata_long <-  bikedata %>% 
  filter(!(weekday %in% c("Sat", "Sun")),
         holiday == F) %>%
  group_by(weekday) %>% 
  summarise(avrg_cyclist = mean(cyclists),
            avrg_temp = mean(temperature))

bikedata_long <- bikedata_long %>% pivot_longer(
  cols = c(avrg_cyclist, avrg_temp),
  names_to = "metric",
  values_to = "value") %>% 
  ggplot((aes(x = weekday, y = value, fill = metric))) +
  geom_col() + 
  facet_wrap( ~ metric, scales = "free_y")

